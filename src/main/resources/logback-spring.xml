<configuration>
  <springProperty scope="context" name="applicationName" source="spring.application.name"/>
  <appender name="json" class="ch.qos.logback.core.ConsoleAppender">
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <pattern>
          <omitEmptyFields>true</omitEmptyFields>
          <pattern>
            {
            "timestamp": "%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}",
            "level": "%level",
<!--            "thread": "%t",-->
<!--            "application": "${applicationName}",-->
<!--            "traceId": "%X{trace_id}",-->
<!--            "spanId": "%X{span_id}",-->
            "taxNumber": "%mdc{taxNumber}",
            "invoiceNumber": "%mdc{invoiceNumber}",
            "invoiceId": "%mdc{invoiceId}",
<!--            "clientId": "%mdc{clientId}",-->
            "errorCode": "%mdc{errorCode}",
            "statusCode": "%mdc{statusCode}",
            "logger": "%logger",
            "message": "%msg",
            "exception": "%ex"
            }
          </pattern>
        </pattern>
      </providers>
    </encoder>
  </appender>

  <!-- Plain file appender — ERROR only, appends to one file, no rolling -->
  <appender name="file" class="ch.qos.logback.core.FileAppender">
    <file>logs/invoice-task-processor.log</file>
    <append>true</append>
    <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
      <level>ERROR</level>
    </filter>
    <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
      <providers>
        <pattern>
          <omitEmptyFields>true</omitEmptyFields>
          <pattern>
            {
            "timestamp": "%d{yyyy-MM-dd'T'HH:mm:ss.SSSZ}",
            "level": "%level",
<!--            "application": "${applicationName}",-->
            "taxNumber": "%mdc{taxNumber}",
            "invoiceNumber": "%mdc{invoiceNumber}",
            "invoiceId": "%mdc{invoiceId}",
            "errorCode": "%mdc{errorCode}",
            "statusCode": "%mdc{statusCode}",
            "logger": "%logger",
            "message": "%msg",
            "exception": "%ex"
            }
          </pattern>
        </pattern>
      </providers>
    </encoder>
  </appender>

  <logger name="jsonLogger" level="TRACE" additivity="false">
    <appender-ref ref="json" />
    <appender-ref ref="file" />
  </logger>

  <root level="INFO">
    <appender-ref ref="json" />
    <appender-ref ref="file" />
  </root>
</configuration>